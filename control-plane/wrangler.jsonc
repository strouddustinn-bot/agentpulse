{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "agentpulse-control-plane",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-12",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "ENVIRONMENT": "development",
    "PUBLIC_BASE_URL": "http://localhost:8787",
    "APP_BASE_URL": "http://localhost:5174",
    "AGENTPULSE_VERSION": "0.1.0",
    "CHECKOUT_MODE": "public",
    "STRIPE_PRICE_STARTER": "",
    "STRIPE_PRICE_PRO": "",
    "STRIPE_PRICE_BUSINESS": ""
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "agentpulse-development",
      "database_id": "local",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "env": {
    "staging": {
      "name": "agentpulse-control-plane-staging",
      "routes": [
        {
          "pattern": "staging-api.agentpulse.ca",
          "custom_domain": true
        }
      ],
      "vars": {
        "ENVIRONMENT": "staging",
        "PUBLIC_BASE_URL": "https://staging-api.agentpulse.ca",
        "APP_BASE_URL": "https://staging-app.agentpulse.ca",
        "AGENTPULSE_VERSION": "0.1.0",
        "CHECKOUT_MODE": "public",
        "STRIPE_PRICE_STARTER": "price_1TxBlVDVV9guBKy9NrWd1x0Q",
        "STRIPE_PRICE_PRO": "price_1TxBo9DVV9guBKy9CkKp0mYf",
        "STRIPE_PRICE_BUSINESS": "price_1TxBpaDVV9guBKy95mWou8FS"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "agentpulse-staging",
          "database_id": "e5b929a6-feb5-40a2-9891-d1c9e9c05a75",
          "migrations_dir": "migrations"
        }
      ]
    },
    "production": {
      "name": "agentpulse-control-plane-production",
      "routes": [
        {
          "pattern": "api.agentpulse.ca",
          "custom_domain": true
        }
      ],
      "vars": {
        "ENVIRONMENT": "production",
        "PUBLIC_BASE_URL": "https://api.agentpulse.ca",
        "APP_BASE_URL": "https://app.agentpulse.ca",
        "AGENTPULSE_VERSION": "0.2.0b3",
        "CHECKOUT_MODE": "closed",
        "STRIPE_PRICE_STARTER": "price_1U0ybfDVV9guBKy9ielFcEy0",
        "STRIPE_PRICE_PRO": "price_1U0ybsDVV9guBKy9R1U5LLw4",
        "STRIPE_PRICE_BUSINESS": "price_1U0ybzDVV9guBKy9Au3LxIro",
        "STRIPE_PORTAL_URL": "https://billing.stripe.com/p/login/6oU28rbSBgPS8Qa5CB7N600"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "agentpulse-production",
          "database_id": "013ade4f-f971-4917-9e0f-0bc8eccdaf92",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
